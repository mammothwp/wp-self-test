parameters:
    level: 5
    paths:
        - src
        - bootstrap.php
    scanFiles:
        - src/Wp_Cli_Shim.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    excludePaths:
        - src/Wp_Cli_Shim.php
    ignoreErrors:
        # Case_Base guards these with method_exists(); the in-process shim lacks the logger API.
        - '#Call to an undefined static method WP_CLI::(get|set)_logger\(\)#'
        # rest_do_request() may return a WP_Error-wrapped response in some WP versions.
        -
            message: '#is_wp_error\(WP_REST_Response\) will always evaluate to false#'
            path: src/Case_Base.php
