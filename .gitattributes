# Keep development-only files out of the dist archives Composer installs.
/.github           export-ignore
/.gitlab-ci.yml    export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/assets/sass       export-ignore
/tests             export-ignore
/phpunit.xml.dist  export-ignore
/phpcs.xml.dist    export-ignore
/phpstan.neon.dist export-ignore
/docs              export-ignore

# Node side of the browser layer (@mammothwp/wp-self-test-e2e): installed by
# npm straight from the git repo, never part of the Composer dist archive.
/package.json      export-ignore
/package-lock.json export-ignore
/e2e               export-ignore
/node_modules      export-ignore
